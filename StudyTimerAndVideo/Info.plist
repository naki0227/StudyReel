<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ni.StudyTimerAndVideo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>studyreel</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>StudyReel uses the camera to turn your study session into a time-lapse video and to scan the barcode or cover of your books. Footage stays on your device unless you choose to share a single frame with your study buddies.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>StudyReel automatically saves your time-lapse video to Photos when a session ends.</string>
	<key>CFBundleDisplayName</key>
	<string>StudyReel</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.ni.StudyTimerAndVideo</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>StudyReel</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
